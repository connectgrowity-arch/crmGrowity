# ---------------------------------------------------------------------------
# Growity CRM · environment variables
# Copy to .env.local and fill in. Never commit real values.
# Supabase dashboard → Project Settings → API Keys
# ---------------------------------------------------------------------------

# Public (safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
# Recommended: the new publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative: the anon JWT key. Used only if the publishable key is empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the app, used in password-reset emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Needed only to create users.
# Recommended: the new secret key (sb_secret_...); legacy service_role JWT also works.
SUPABASE_SECRET_KEY=
